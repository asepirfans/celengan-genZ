# Supabase Postgres connection string (use the pooler URL, port 6543, with pgbouncer=true)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true

# Resend receiving domain (custom MX domain or assigned *.resend.app domain).
INBOUND_EMAIL_PROVIDER=resend
INBOUND_EMAIL_DOMAIN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Set INBOUND_EMAIL_PROVIDER=cloudflare only after the domain and Worker are ready.
# Keep legacy Resend keys/domain while existing users migrate their Gmail filters.
CLOUDFLARE_EMAIL_DOMAIN=
CLOUDFLARE_EMAIL_SECRET=
