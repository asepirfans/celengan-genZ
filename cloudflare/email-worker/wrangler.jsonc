{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "celengan-email-ingress",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "vars": {
    "EMAIL_DOMAIN": "cloudiolabs.my.id",
    "WEBHOOK_URL": "https://celengan-gen-z.vercel.app/api/webhooks/cloudflare-email"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
}
